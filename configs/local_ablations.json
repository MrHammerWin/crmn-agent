{
  "name": "local_validation_ablations",
  "purpose": "Short real local ablations; engineering validation only",
  "split": "validation",
  "benchmarks": [
    "babyai_text"
  ],
  "variants": [
    "no_cycle",
    "no_prediction",
    "no_reward",
    "map_only",
    "plan_only"
  ],
  "seeds": [
    10001
  ],
  "max_steps": 2,
  "history_turns": 4,
  "provider": {
    "backend": "mlx",
    "model": "mlx-community/Qwen2.5-1.5B-Instruct-4bit",
    "model_path": "models/qwen2.5-1.5b-4bit",
    "max_output_tokens": 448,
    "max_calls": 1200,
    "max_total_tokens": 2000000,
    "max_usd": 0,
    "structured_decoding": "outlines-json-schema"
  },
  "babyai_protocol": "balrog_mixed",
  "alfworld_data": "data/alfworld",
  "results_dir": "results/local_ablations",
  "prior_path": "local/checkpoints/prior.json"
}